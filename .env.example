# Copy this file to .env and fill in real values. .env is gitignored — never
# commit actual secrets.

# Postgres connection strings from Neon (or Vercel Postgres, which is Neon
# under the hood). Neon gives you both when you create a project:
#   DATABASE_URL  — the pooled connection (what the app uses at request time)
#   DIRECT_URL    — the unpooled connection (what `prisma db push` needs)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the PIN-unlock session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required on Vercel — the app refuses to boot there without it, since a
# missing secret would mean falling back to a guessable one. Optional
# locally (a fixed dev-only value is used if unset).
SESSION_SECRET=""

# --- Only needed once this is deployed publicly, not for local dev ---

# Set to "true" on the Vercel deployment to force the PIN lock permanently on
# (Settings can't turn it off). Leave unset locally.
FORCE_PIN=""

# The PIN the app bootstraps itself with the first time it boots under
# FORCE_PIN=true, before anyone has visited Settings to set one. 4–8 digits.
# Change it once from inside the app after your first login, then you can
# remove this variable — it's only read when no PIN exists yet.
INITIAL_PIN=""

# Authorizes the Vercel Cron request that backs up the monthly checklist
# reset (see vercel.json). Generate the same way as SESSION_SECRET.
CRON_SECRET=""
