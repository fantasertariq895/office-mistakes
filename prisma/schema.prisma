// Personal Office Operations Dashboard — data model (PRD §5)
//
// Postgres (Neon / Vercel Postgres) so the same database works both locally
// and once deployed — Vercel's serverless filesystem is read-only, so the
// original SQLite file can't live there. DATABASE_URL is the pooled
// connection (used by the app at request time); DIRECT_URL is the unpooled
// one Prisma needs for `db push`/migrations. Neon gives you both.
//
// There's no native enum support in play here, so enum-ish columns are stored
// as String and validated in lib/constants.ts. Fields marked "[addition]" are
// not in the PRD but are required to make the specified behaviour work;
// everything else maps 1:1 to PRD §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Commission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#6B7280")
  description String?
  sortOrder   Int      @default(0) // [addition] stable ordering in the UI
  createdAt   DateTime @default(now())

  checklistItems       ChecklistItem[]
  mistakes             MistakeLogEntry[]
  contacts             Contact[]
  approvalRequirements ApprovalRequirement[]
  tasks                Task[]
}

model ChecklistItem {
  id           Int       @id @default(autoincrement())
  commissionId Int? // null = universal (Mistake Prevention)
  text         String
  category     String?
  isHighRisk   Boolean   @default(false)
  isCustom     Boolean   @default(false)
  checkedAt    DateTime? // [addition] persists tick state between reloads; "Reset" clears it
  sortOrder    Int       @default(0) // [addition]
  createdAt    DateTime  @default(now())

  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model MistakeLogEntry {
  id           Int      @id @default(autoincrement())
  commissionId Int
  text         String
  dateLogged   DateTime @default(now())
  resolved     Boolean  @default(false)

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model Contact {
  id           Int     @id @default(autoincrement())
  commissionId Int
  name         String
  role         String?
  email        String?
  phone        String?

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model ApprovalRequirement {
  id           Int    @id @default(autoincrement())
  commissionId Int
  description  String

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  priority     String    @default("medium") // low | medium | high
  status       String    @default("not_started") // not_started | in_progress | completed | waiting
  dueDate      DateTime?
  commissionId Int?
  notes        String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([commissionId])
}

/* -------------------------------------------------------- Traffic Billing --
 *
 * A deliberately separate island from Commission/ChecklistItem, for two
 * reasons that are easy to miss:
 *
 * 1. lib/monthly-reset.ts unticks *every* ChecklistItem with no commission
 *    filter. Traffic Billing is a month-long, ~300-step procedure whose
 *    completed state is the record of what was actually done — silently
 *    wiping it on the 1st would destroy exactly the thing worth keeping.
 * 2. Traffic Billing has a run dimension (one execution per billing month,
 *    kept forever) that ChecklistItem's single mutable `checkedAt` can't
 *    express.
 *
 * Content (phases/steps/mistakes) is seeded from "Traffic Billing SOP.md" via
 * lib/traffic-billing/sop-template.ts but lives in the database, so steps can
 * be edited, reordered and added in the app. State (what's ticked, in which
 * month) is a separate table keyed by run — editing a step's wording never
 * disturbs the history of the months it was already ticked in.
 */

model TrafficBillingPhase {
  id        Int      @id @default(autoincrement())
  /** Stable slug ("p04"). Seeds match on this, so re-seeding never duplicates. */
  key       String   @unique
  number    Int
  /** Groups phases into the collapsible stages in the rail (see sop-template). */
  stageKey  String
  title     String
  /** Lead-in prose from the SOP, e.g. "After all raw data has been entered:". */
  intro     String?
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  steps    TrafficBillingStep[]
  mistakes TrafficBillingMistake[]
  issues   TrafficBillingIssue[]
}

model TrafficBillingStep {
  id         Int      @id @default(autoincrement())
  phaseId    Int
  key        String   @unique
  /** Sub-heading this step sits under, e.g. "Performance Max Classification". */
  groupLabel String?
  text       String
  /** JSON array of reference bullets shown under the step, not tickable. */
  notes      String?
  isHighRisk Boolean  @default(false)
  isCustom   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  phase  TrafficBillingPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  states TrafficBillingStepState[]

  @@index([phaseId])
}

model TrafficBillingMistake {
  id        Int     @id @default(autoincrement())
  /** Null = applies to the whole SOP, not one phase. */
  phaseId   Int?
  text      String
  sortOrder Int     @default(0)
  isCustom  Boolean @default(false)

  phase TrafficBillingPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

/** One execution of the SOP, for one billing month. Kept indefinitely. */
model TrafficBillingRun {
  id          Int       @id @default(autoincrement())
  month       String    @unique // "2026-08"
  status      String    @default("in_progress") // in_progress | completed
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  states TrafficBillingStepState[]
  issues TrafficBillingIssue[]

  @@index([status])
}

/**
 * Created lazily — an untouched step has no row and reads as "open". A fresh
 * month is one insert, not 304.
 */
model TrafficBillingStepState {
  id        Int      @id @default(autoincrement())
  runId     Int
  stepId    Int
  state     String   @default("open") // open | done | na
  note      String?
  updatedAt DateTime @updatedAt

  run  TrafficBillingRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step TrafficBillingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([runId, stepId])
  @@index([runId])
}

/** Something that went wrong during a run, logged against the phase it hit. */
model TrafficBillingIssue {
  id        Int      @id @default(autoincrement())
  runId     Int
  phaseId   Int
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  run   TrafficBillingRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase TrafficBillingPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/**
 * Trader Media — weekly (Monday-anchored) media revenue reporting checklist.
 * Architecturally a clone of the TrafficBilling* models above, with "month"
 * swapped for "Monday-dated week" and one addition (isOwnerPending) neither
 * needed: this SOP has phases that are explicitly not the user's job yet
 * (Yuvika's FP&A judgment, the Benoit review, deck production) but are kept
 * visible so ownership can grow into them without a schema change. See
 * CLAUDE.md for the full rationale.
 */
model TraderMediaPhase {
  id        Int      @id @default(autoincrement())
  /** Stable slug ("p04"). Seeds match on this, so re-seeding never duplicates. */
  key       String   @unique
  number    Int
  title     String
  /** Lead-in prose from the SOP. */
  intro     String?
  /** True for phases that are Yuvika's / not yet the user's job (7–13). */
  isOwnerPending Boolean @default(false)
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  steps    TraderMediaStep[]
  mistakes TraderMediaMistake[]
  issues   TraderMediaIssue[]
}

model TraderMediaStep {
  id         Int      @id @default(autoincrement())
  phaseId    Int
  key        String   @unique
  /** Sub-heading this step sits under, e.g. "Update PIO Data". */
  groupLabel String?
  text       String
  /** JSON array of reference bullets shown under the step, not tickable. */
  notes      String?
  isHighRisk Boolean  @default(false)
  isCustom   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  phase  TraderMediaPhase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  states TraderMediaStepState[]

  @@index([phaseId])
}

model TraderMediaMistake {
  id        Int     @id @default(autoincrement())
  /** Null = applies to the whole SOP, not one phase. */
  phaseId   Int?
  text      String
  sortOrder Int     @default(0)
  isCustom  Boolean @default(false)

  phase TraderMediaPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

/** One execution of the SOP, for one Monday-anchored week. Kept indefinitely. */
model TraderMediaRun {
  id          Int       @id @default(autoincrement())
  week        String    @unique // "2026-08-24" — the Monday
  status      String    @default("in_progress") // in_progress | completed
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  states TraderMediaStepState[]
  issues TraderMediaIssue[]

  @@index([status])
}

/**
 * Created lazily — an untouched step has no row and reads as "open". A fresh
 * week is one insert, not N.
 */
model TraderMediaStepState {
  id        Int      @id @default(autoincrement())
  runId     Int
  stepId    Int
  state     String   @default("open") // open | done | na
  note      String?
  updatedAt DateTime @updatedAt

  run  TraderMediaRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step TraderMediaStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([runId, stepId])
  @@index([runId])
}

/** Something that went wrong during a run, logged against the phase it hit. */
model TraderMediaIssue {
  id        Int      @id @default(autoincrement())
  runId     Int
  phaseId   Int
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  run   TraderMediaRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase TraderMediaPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/**
 * One-time "Access / Things You Need" setup checklist. NOT scoped to any
 * weekly run, never resets, checked once ever. Deliberately outside the
 * Phase/Step/Run/StepState system — it has no per-run history and no weekly
 * reset, so reusing that machinery would mean modeling a fake run just to
 * hang state off.
 */
model TraderMediaSetupItem {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  text      String
  sortOrder Int       @default(0)
  done      Boolean   @default(false)
  doneAt    DateTime?
}

/**
 * A dictated note and the tasks it produced.
 *
 * Kept so a bad batch can be undone in one action and so you can see what was
 * actually heard when a task reads oddly — speech recognition mangles proper
 * nouns ("O'Regan", "TRFFK") often enough that the raw transcript is the only
 * way to tell a mis-hearing from a mis-parse.
 *
 * `taskIds` is a JSON array rather than a relation on purpose: adding a
 * foreign key to Task would mean altering a table the rest of the dashboard
 * depends on, and this feature has no business doing that.
 */
model VoiceNote {
  id         Int      @id @default(autoincrement())
  transcript String
  taskIds    String   @default("[]")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model NotificationRule {
  id      Int     @id @default(autoincrement())
  type    String // task_due | task_overdue | daily_digest
  channel String // in_app | email | whatsapp
  enabled Boolean @default(false)

  @@unique([type, channel])
}

model Settings {
  id                   Int      @id @default(1) // singleton row
  pinHash              String? // format: scrypt$<saltHex>$<hashHex>
  // Bumped whenever the PIN is set/changed/removed. Session tokens embed the
  // version they were issued under (see lib/auth.ts) — bumping this is how
  // "sign out everywhere" works without a server-side session store, which
  // matters once this runs on stateless serverless instances.
  sessionVersion       Int      @default(1)
  // "YYYY-MM" of the last automatic checklist reset. Null means it hasn't run
  // yet — the first run only records the current month, it does not reset
  // (so shipping this feature doesn't wipe ticks mid-month on existing data).
  checklistsResetMonth String?
  notificationChannels String   @default("[\"in_app\"]") // JSON array
  quietHoursStart      String? // "HH:MM" local, null = no quiet hours
  quietHoursEnd        String?
  emailSmtpConfig      String? // JSON — Phase 2, unused in MVP
  whatsappConfig       String? // JSON — Phase 3, unused in MVP
  theme                String   @default("light") // light | dark
  updatedAt            DateTime @updatedAt
}

/* -------------------------------------------------------------- Founder OS --
 * Phase 1 of a personal-side workspace (Dashboard, Sales Pipeline, Master
 * Task List) in the "Personal" sidebar group. Total isolation from
 * Commission, ChecklistItem, Task, and the Traffic Billing / Trader Media
 * tables — own tables, own API/lib/component trees, mirroring Traffic
 * Billing / Trader Media. More modules land here in later phases as
 * additional Founder-prefixed tables.
 */

model FounderPipelineContact {
  id            Int       @id @default(autoincrement())
  name          String
  company       String?
  /** Free text — "LinkedIn" / "Email" / "Referral" / etc. No fixed enum. */
  channel       String?
  /** Calendar day, UTC-anchored like Task.dueDate — see lib/date.ts. */
  dateContacted DateTime?
  status        String    @default("contacted") // contacted | replied | call_booked | proposal_sent | closed | no_response
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model FounderTask {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("not_started") // not_started | in_progress | waiting | completed | blocked
  priority    String    @default("medium") // critical | high | medium | low
  dueDate     DateTime?
  /** Manual ordering within a Kanban column. */
  sortOrder   Int       @default(0)
  /** Monday-dated week key ("2026-08-24") if picked for the Weekly Planner, else null. */
  plannedForWeek String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([priority])
}

/** Singleton — Day 1 of the 90-day runway, set once in-app, never hardcoded. */
model FounderSettings {
  id        Int       @id @default(1)
  startDate DateTime?
  updatedAt DateTime  @updatedAt
}

/* --------------------------------------------------- Founder OS, Phase 2/3 --
 * The remaining 17 modules from claude-code-prompt-founder-os.md. Several
 * genuinely different modules share one generic table on purpose (see each
 * model's comment) rather than getting a bespoke model apiece — this is a
 * personal single-user planning tool, not a product, and the source doc's
 * modules are mostly "a few labeled fields" or "a short table," which a
 * generic key/section model represents faithfully without 17 near-identical
 * models. Where a module has real structure worth typing explicitly
 * (competitors, costs, risks, tech stack) it still gets its own model.
 */

/**
 * Generic single-value text field, keyed and grouped by `section`. Backs:
 * Business Model Canvas (section "bmc", 9 keys), Ideal Customer Profile
 * (section "icp", 7 keys), Brand & Website homepage copy (section "brand",
 * 5 keys + a site-map note per page), Hiring & Team notes (section
 * "hiring"), Funding Notes (section "funding", 1 key), and the 12-Month
 * Roadmap (section "roadmap", one key per month). Seeded with real content
 * from the source doc where given; `content` starts blank where the doc
 * says "the founder fills this in."
 */
model FounderTextBlock {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  section   String
  label     String
  content   String?
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/** Business Opportunity Scorecard — 9 editable 1-10 scores, overall is computed, not stored. */
model FounderScore {
  id        Int    @id @default(autoincrement())
  key       String @unique
  label     String
  score     Int    @default(5) // 1-10
  sortOrder Int    @default(0)
}

/** Competitor matrix row. Seeded with the 5 real competitors from the source doc. */
model FounderCompetitor {
  id             Int     @id @default(autoincrement())
  name           String
  service        String?
  price          String?
  targetCustomer String?
  strengths      String?
  weaknesses     String?
  positioning    String?
  opportunity    String?
  isCustom       Boolean @default(false)
  sortOrder      Int     @default(0)
}

/** Startup cost tracker row. Seeded with the $2,000 CAD budget table from the source doc. */
model FounderCostItem {
  id        Int     @id @default(autoincrement())
  name      String
  type      String // one_time | recurring
  amountCad Float
  isCustom  Boolean @default(false)
  sortOrder Int     @default(0)
}

/** Revenue forecast row, one per month 1-12. Editable, seeded at zero. */
model FounderRevenueMonth {
  id                  Int   @id @default(autoincrement())
  monthNumber         Int   @unique // 1-12
  clients             Int   @default(0)
  avgRevenuePerClient Float @default(0)
  costOfDelivery      Float @default(0)
}

/** Pricing tier. Seeded with 3 blank packages, the $100-200/user/month competitor benchmark noted in the label. */
model FounderPricingTier {
  id          Int     @id @default(autoincrement())
  name        String // Basic | Professional | Premium
  priceCad    Float?
  description String?
  sortOrder   Int     @default(0)
}

/** Tech stack tracker row. Seeded with the cheap/free tools the source doc names. */
model FounderTechStackItem {
  id        Int     @id @default(autoincrement())
  tool      String
  purpose   String?
  costCad   Float?
  priority  String  @default("medium") // critical | high | medium | low
  status    String  @default("not_set_up") // not_set_up | set_up
  isCustom  Boolean @default(false)
  sortOrder Int     @default(0)
}

/** Risk register row. Seeded with the 3 risks named in the source doc. */
model FounderRiskItem {
  id          Int     @id @default(autoincrement())
  risk        String
  probability String  @default("medium") // low | medium | high
  impact      String  @default("medium") // low | medium | high
  prevention  String?
  backupPlan  String?
  isCustom    Boolean @default(false)
  sortOrder   Int     @default(0)
}

/** One week of the 90-day outreach/content calendar. Seeded blank for weeks 1-13. */
model FounderMarketingWeek {
  id               Int     @id @default(autoincrement())
  weekNumber       Int     @unique
  plannedOutreach  Int?
  plannedContent   String?
  notes            String?
}

/**
 * Generic checklist, keyed. Backs the Legal & Compliance Checklist (key
 * "legal") and the First Customer Plan (key "first-customer", day-by-day
 * then week-by-week). Deliberately its own table, not ChecklistItem —
 * lib/monthly-reset.ts unticks every ChecklistItem with no commission
 * filter, and neither a legal checklist nor a first-customer plan should
 * ever be silently wiped on the 1st.
 */
model FounderChecklist {
  id    Int    @id @default(autoincrement())
  key   String @unique
  title String

  items FounderChecklistItem[]
}

model FounderChecklistItem {
  id          Int       @id @default(autoincrement())
  checklistId Int
  text        String
  /** "Why it matters" note, shown under the item. */
  explanation String?
  /** "Day 1", "Week 2-4", etc — null for items with no day/week grouping. */
  dayLabel    String?
  done        Boolean   @default(false)
  doneAt      DateTime?
  isCustom    Boolean   @default(false)
  sortOrder   Int       @default(0)

  checklist FounderChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

/**
 * Named document, keyed and grouped by `section`. Backs the Operations/SOPs
 * library (section "sop") and the Document Templates library (section
 * "template"). Freely addable in the app (isCustom rows have no seed key).
 */
model FounderDocument {
  id        Int      @id @default(autoincrement())
  key       String?  @unique
  section   String // sop | template
  title     String
  content   String?
  isCustom  Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/** Decision Log entry. Starts empty — this is the founder's own running record. */
model FounderLogEntry {
  id           Int      @id @default(autoincrement())
  decision     String
  reasoning    String?
  alternatives String?
  outcome      String?
  createdAt    DateTime @default(now())
}

/**
 * The master 90-day execution plan, as one continuous phase-by-phase,
 * step-by-step checklist — same rail/progress-bar/sequential-navigation
 * shape as TrafficBillingPhase/Step and TraderMediaPhase/Step, but
 * deliberately simpler: this is a one-time journey (register the business →
 * build the site → outreach → close the first client), not a recurring
 * SOP, so there's no run/week dimension and no separate state table — a
 * step's state lives directly on the row. 13 phases, one per week of the
 * 90-day plan, folding in the Legal checklist's real requirements and the
 * Access/tooling needs at the point in the plan they actually come up,
 * rather than leaving them scattered across separate tabs.
 */
model FounderPlanPhase {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  number    Int
  title     String
  intro     String?
  /** Display-only, e.g. "Days 1-7". */
  dayRange  String?
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  steps    FounderPlanStep[]
  mistakes FounderPlanMistake[]
}

model FounderPlanStep {
  id         Int       @id @default(autoincrement())
  phaseId    Int
  key        String    @unique
  groupLabel String?
  text       String
  /** JSON array of reference bullets, not tickable. */
  notes      String?
  state      String    @default("open") // open | done | na
  note       String?
  doneAt     DateTime?
  isHighRisk Boolean   @default(false)
  isCustom   Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  phase FounderPlanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

model FounderPlanMistake {
  id        Int     @id @default(autoincrement())
  phaseId   Int?
  text      String
  sortOrder Int     @default(0)
  isCustom  Boolean @default(false)

  phase FounderPlanPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}
