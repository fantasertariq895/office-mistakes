// Personal Office Operations Dashboard — data model (PRD §5)
//
// Postgres (Neon / Vercel Postgres) so the same database works both locally
// and once deployed — Vercel's serverless filesystem is read-only, so the
// original SQLite file can't live there. DATABASE_URL is the pooled
// connection (used by the app at request time); DIRECT_URL is the unpooled
// one Prisma needs for `db push`/migrations. Neon gives you both.
//
// There's no native enum support in play here, so enum-ish columns are stored
// as String and validated in lib/constants.ts. Fields marked "[addition]" are
// not in the PRD but are required to make the specified behaviour work;
// everything else maps 1:1 to PRD §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Commission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#6B7280")
  description String?
  sortOrder   Int      @default(0) // [addition] stable ordering in the UI
  createdAt   DateTime @default(now())

  checklistItems       ChecklistItem[]
  mistakes             MistakeLogEntry[]
  contacts             Contact[]
  approvalRequirements ApprovalRequirement[]
  tasks                Task[]
}

model ChecklistItem {
  id           Int       @id @default(autoincrement())
  commissionId Int? // null = universal (Mistake Prevention)
  text         String
  category     String?
  isHighRisk   Boolean   @default(false)
  isCustom     Boolean   @default(false)
  checkedAt    DateTime? // [addition] persists tick state between reloads; "Reset" clears it
  sortOrder    Int       @default(0) // [addition]
  createdAt    DateTime  @default(now())

  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model MistakeLogEntry {
  id           Int      @id @default(autoincrement())
  commissionId Int
  text         String
  dateLogged   DateTime @default(now())
  resolved     Boolean  @default(false)

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model Contact {
  id           Int     @id @default(autoincrement())
  commissionId Int
  name         String
  role         String?
  email        String?
  phone        String?

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model ApprovalRequirement {
  id           Int    @id @default(autoincrement())
  commissionId Int
  description  String

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  priority     String    @default("medium") // low | medium | high
  status       String    @default("not_started") // not_started | in_progress | completed | waiting
  dueDate      DateTime?
  commissionId Int?
  notes        String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([commissionId])
}

/* -------------------------------------------------------- Traffic Billing --
 *
 * A deliberately separate island from Commission/ChecklistItem, for two
 * reasons that are easy to miss:
 *
 * 1. lib/monthly-reset.ts unticks *every* ChecklistItem with no commission
 *    filter. Traffic Billing is a month-long, ~300-step procedure whose
 *    completed state is the record of what was actually done — silently
 *    wiping it on the 1st would destroy exactly the thing worth keeping.
 * 2. Traffic Billing has a run dimension (one execution per billing month,
 *    kept forever) that ChecklistItem's single mutable `checkedAt` can't
 *    express.
 *
 * Content (phases/steps/mistakes) is seeded from "Traffic Billing SOP.md" via
 * lib/traffic-billing/sop-template.ts but lives in the database, so steps can
 * be edited, reordered and added in the app. State (what's ticked, in which
 * month) is a separate table keyed by run — editing a step's wording never
 * disturbs the history of the months it was already ticked in.
 */

model TrafficBillingPhase {
  id        Int      @id @default(autoincrement())
  /** Stable slug ("p04"). Seeds match on this, so re-seeding never duplicates. */
  key       String   @unique
  number    Int
  /** Groups phases into the collapsible stages in the rail (see sop-template). */
  stageKey  String
  title     String
  /** Lead-in prose from the SOP, e.g. "After all raw data has been entered:". */
  intro     String?
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  steps    TrafficBillingStep[]
  mistakes TrafficBillingMistake[]
  issues   TrafficBillingIssue[]
}

model TrafficBillingStep {
  id         Int      @id @default(autoincrement())
  phaseId    Int
  key        String   @unique
  /** Sub-heading this step sits under, e.g. "Performance Max Classification". */
  groupLabel String?
  text       String
  /** JSON array of reference bullets shown under the step, not tickable. */
  notes      String?
  isHighRisk Boolean  @default(false)
  isCustom   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  phase  TrafficBillingPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  states TrafficBillingStepState[]

  @@index([phaseId])
}

model TrafficBillingMistake {
  id        Int     @id @default(autoincrement())
  /** Null = applies to the whole SOP, not one phase. */
  phaseId   Int?
  text      String
  sortOrder Int     @default(0)
  isCustom  Boolean @default(false)

  phase TrafficBillingPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

/** One execution of the SOP, for one billing month. Kept indefinitely. */
model TrafficBillingRun {
  id          Int       @id @default(autoincrement())
  month       String    @unique // "2026-08"
  status      String    @default("in_progress") // in_progress | completed
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  states TrafficBillingStepState[]
  issues TrafficBillingIssue[]

  @@index([status])
}

/**
 * Created lazily — an untouched step has no row and reads as "open". A fresh
 * month is one insert, not 304.
 */
model TrafficBillingStepState {
  id        Int      @id @default(autoincrement())
  runId     Int
  stepId    Int
  state     String   @default("open") // open | done | na
  note      String?
  updatedAt DateTime @updatedAt

  run  TrafficBillingRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step TrafficBillingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([runId, stepId])
  @@index([runId])
}

/** Something that went wrong during a run, logged against the phase it hit. */
model TrafficBillingIssue {
  id        Int      @id @default(autoincrement())
  runId     Int
  phaseId   Int
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  run   TrafficBillingRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase TrafficBillingPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/**
 * A dictated note and the tasks it produced.
 *
 * Kept so a bad batch can be undone in one action and so you can see what was
 * actually heard when a task reads oddly — speech recognition mangles proper
 * nouns ("O'Regan", "TRFFK") often enough that the raw transcript is the only
 * way to tell a mis-hearing from a mis-parse.
 *
 * `taskIds` is a JSON array rather than a relation on purpose: adding a
 * foreign key to Task would mean altering a table the rest of the dashboard
 * depends on, and this feature has no business doing that.
 */
model VoiceNote {
  id         Int      @id @default(autoincrement())
  transcript String
  taskIds    String   @default("[]")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model NotificationRule {
  id      Int     @id @default(autoincrement())
  type    String // task_due | task_overdue | daily_digest
  channel String // in_app | email | whatsapp
  enabled Boolean @default(false)

  @@unique([type, channel])
}

model Settings {
  id                   Int      @id @default(1) // singleton row
  pinHash              String? // format: scrypt$<saltHex>$<hashHex>
  // Bumped whenever the PIN is set/changed/removed. Session tokens embed the
  // version they were issued under (see lib/auth.ts) — bumping this is how
  // "sign out everywhere" works without a server-side session store, which
  // matters once this runs on stateless serverless instances.
  sessionVersion       Int      @default(1)
  // "YYYY-MM" of the last automatic checklist reset. Null means it hasn't run
  // yet — the first run only records the current month, it does not reset
  // (so shipping this feature doesn't wipe ticks mid-month on existing data).
  checklistsResetMonth String?
  notificationChannels String   @default("[\"in_app\"]") // JSON array
  quietHoursStart      String? // "HH:MM" local, null = no quiet hours
  quietHoursEnd        String?
  emailSmtpConfig      String? // JSON — Phase 2, unused in MVP
  whatsappConfig       String? // JSON — Phase 3, unused in MVP
  theme                String   @default("light") // light | dark
  updatedAt            DateTime @updatedAt
}
